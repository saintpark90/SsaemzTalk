# Supabase Postgres (recommended)
# Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL: Transaction pooler (port 6543) — app runtime / Prisma Client
# DIRECT_URL:   Direct connection (port 5432) — prisma db push / migrate
#
# Replace [PASSWORD] and [PROJECT-REF] with your project values.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Local Postgres fallback (optional — docker compose up -d)
# DATABASE_URL="postgresql://ssaemz:ssaemz@localhost:5432/ssaemztalk?schema=public"
# DIRECT_URL="postgresql://ssaemz:ssaemz@localhost:5432/ssaemztalk?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
UPLOAD_DIR="public/uploads"
